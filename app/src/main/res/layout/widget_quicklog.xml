<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageView android:id="@+id/w_list"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_margin="5dp" android:background="@drawable/widget_tile_bg"
            android:padding="14dp" android:scaleType="fitCenter"
            android:src="@drawable/ic_w_list" android:contentDescription="Registro rápido" />

        <ImageView android:id="@+id/w_search"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_margin="5dp" android:background="@drawable/widget_tile_bg"
            android:padding="14dp" android:scaleType="fitCenter"
            android:src="@drawable/ic_w_search" android:contentDescription="Buscar" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageView android:id="@+id/w_camera"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_margin="5dp" android:background="@drawable/widget_tile_bg"
            android:padding="14dp" android:scaleType="fitCenter"
            android:src="@drawable/ic_w_camera" android:contentDescription="Escanear" />

        <ImageView android:id="@+id/w_mic"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_margin="5dp" android:background="@drawable/widget_tile_bg"
            android:padding="14dp" android:scaleType="fitCenter"
            android:src="@drawable/ic_w_mic" android:contentDescription="Voz" />
    </LinearLayout>
</LinearLayout>

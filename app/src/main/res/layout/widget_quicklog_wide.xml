<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:padding="10dp">

    <FrameLayout
        android:id="@+id/w_search"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="8dp"
        android:background="@drawable/widget_search_bg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="18dp"
            android:text="@string/widget_search_hint"
            android:textColor="#8E8E93"
            android:textSize="15sp" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="18dp"
            android:src="@drawable/ic_w_search"
            android:contentDescription="@string/widget_search_hint" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageView android:id="@+id/w_list"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginEnd="8dp" android:background="@drawable/widget_tile_bg"
            android:padding="14dp" android:scaleType="fitCenter"
            android:src="@drawable/ic_w_list" android:contentDescription="Registro rápido" />

        <ImageView android:id="@+id/w_camera"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginEnd="8dp" android:background="@drawable/widget_tile_bg"
            android:padding="14dp" android:scaleType="fitCenter"
            android:src="@drawable/ic_w_camera" android:contentDescription="Escanear" />

        <ImageView android:id="@+id/w_mic"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="@drawable/widget_tile_bg"
            android:padding="14dp" android:scaleType="fitCenter"
            android:src="@drawable/ic_w_mic" android:contentDescription="Voz" />
    </LinearLayout>
</LinearLayout>
